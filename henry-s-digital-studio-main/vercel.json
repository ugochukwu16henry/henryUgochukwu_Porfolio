{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "env": {
    "NITRO_PRESET": "vercel"
  },
  "headers": [
    {
      "source": "/resume/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/pdf" }]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [{ "key": "Content-Type", "value": "application/pdf" }]
    }
  ]
}
